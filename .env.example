# ============================================================
# DATA PRIVACY RISK CHECKER - LOCAL HOST ENVIRONMENT
# ============================================================

# Service Settings (Localhost)
PROJECT_NAME="Data Privacy Risk Checker"
VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8000
DEBUG=False

# Local Host Persistence: Set to False to use the built-in local JSON file store (backend/data/scan_history.json)
ENABLE_MONGODB=False
DATABASE_NAME="data_privacy_checker"

# File Processing Constraints
MAX_FILE_SIZE_MB=10

# Security / CORS (Strictly Localhost)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000"
