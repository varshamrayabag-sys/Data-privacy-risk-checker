# ============================================================
# DATA PRIVACY RISK CHECKER - ENVIRONMENT CONFIGURATION
# ============================================================

# Service Settings
PROJECT_NAME="Data Privacy Risk Checker"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=False

# MongoDB Database Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="data_privacy_checker"

# File Processing Constraints
MAX_FILE_SIZE_MB=10

# Security / CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://data-privacy-checker.vercel.app"
